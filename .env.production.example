APP_NAME=OpenCash
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ganti-dengan-domain-kamu

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Platform (Railway/Render) sebaiknya log ke stderr. VPS boleh "single".
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (WAJIB MySQL) ---
# Project ini punya migration MySQL-specific (DATE_ADD/DATE_SUB),
# jadi jangan pakai Postgres/SQLite untuk produksi.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session & cache ---
# CATATAN: tabel `cache` TIDAK ada di migration project ini,
# jadi CACHE_STORE harus "file" (bukan "database"), kalau tidak akan error.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database

# --- Storage ---
# "local" = disk container (butuh volume permanen di /app/storage/app/public).
# Ganti ke "s3" (Cloudflare R2) kalau platform tidak punya volume.
FILESYSTEM_DISK=local

# --- Mail (belum dipakai; biar tidak error) ---
MAIL_MAILER=log
